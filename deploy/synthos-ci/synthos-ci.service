[Unit]
Description=SYNTHOS Sovereign CI & Release Builder
After=network-online.target synthos-comet.service
Wants=network-online.target

[Service]
Type=oneshot

# 1. Unprivileged user isolation (never run as root)
User=synthos-ci
Group=synthos-ci
WorkingDirectory=/var/lib/synthos-ci

# 2. Strict filesystem isolation: prevent any access to node data, validator keys, or live secrets
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Prefix with '-' so systemd ignores paths if not present, preventing 226/NAMESPACE startup failures
# /etc/synthos holds live secrets (e.g. the reward-keeper wallet key), so CI
# code and tests must never be able to read it.
InaccessiblePaths=-/var/lib/synthos -/var/lib/synthos-comet -/etc/synthos -/root -/home
ReadWritePaths=/var/lib/synthos-ci /var/www/synthos/website/downloads/releases -/tmp

# 3. Lowest CPU & I/O priority: synthos-comet always gets the machine first
Nice=19
CPUSchedulingPolicy=batch
CPUWeight=10
CPUQuota=60%
IOSchedulingClass=idle

# 4. Memory caps & sacrificial OOM priority: kill CI before synthos-comet
MemoryHigh=1200M
MemoryMax=1500M
OOMScoreAdjust=1000

# 5. Environment
Environment=HOME=/var/lib/synthos-ci
Environment=GOPATH=/var/lib/synthos-ci/gopath
Environment=GOCACHE=/var/lib/synthos-ci/gocache
Environment=TMPDIR=/var/lib/synthos-ci/tmp
Environment=PATH=/usr/local/go/bin:/usr/bin:/bin

# 6. Service lifecycle (triggered by synthos-ci.timer)
ExecStart=/usr/local/bin/synthos-ci

[Install]
WantedBy=multi-user.target
