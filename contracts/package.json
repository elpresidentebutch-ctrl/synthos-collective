{
  "name": "@synthos-collective/contracts",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy:synthos:local": "hardhat run scripts/deploy-synthos.js --network hardhat",
    "dex:add-pool": "hardhat run scripts/add-dex-pool.js",
    "wbtc:enable": "hardhat run scripts/enable-wbtc-payment.js",
    "bitcoin-sale:deploy": "hardhat run scripts/deploy-bitcoin-sale.js",
    "bitcoin-sale:confirm": "hardhat run scripts/confirm-bitcoin-payment.js",
    "postdeploy:check": "hardhat run scripts/post-deploy-check.js",
    "readiness:contracts": "hardhat compile && hardhat test && hardhat run scripts/readiness-check.js --network hardhat",
    "merkle:adopters": "node scripts/build-adopter-merkle.js",
    "merkle:adopters:example": "node scripts/build-adopter-merkle.js merkle/adopters.example.json merkle/adopter-merkle.example.json",
    "merkle:set": "hardhat run scripts/set-adopter-merkle-root.js"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.0",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.0",
    "@openzeppelin/contracts": "^4.9.6",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "chai": "^4.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.4.0",
    "hardhat": "^2.22.17",
    "hardhat-gas-reporter": "^1.0.8",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^7.0.2"
  }
