# Copy to .env (never commit .env). Used by Hardhat networks in hardhat.config.js

# Testnet / mainnet deployer (hex private key, 0x-prefixed)
# PRIVATE_KEY=0x...

SYNTHOS_RPC_URL=https://your-rpc.example
SYNTHOS_CHAIN_ID=1234

GEMINI_RPC_URL=https://your-gemini-rpc.example
GEMINI_CHAIN_ID=2048

# Timelock min delay in seconds (deploy script default: 60 on hardhat, 172800 elsewhere)
# TIMELOCK_MIN_DELAY=172800

# Launch allocation wallets. Use separate wallets or multisigs where possible.
# FOUNDER_WALLET=0xYourFounderVestingBeneficiary
# FOUNDER_OPS_WALLET=0xYourFounderLaunchAllocationWallet
# CMO_WALLET=0xYourCmoGrantWallet
# IMMUNE_NODE_REWARDS_WALLET=0xYourImmuneRewardsControllerOrContract
# VALIDATOR_REWARDS_WALLET=0xYourValidatorRewardsControllerOrContract
# DEX_LIQUIDITY_WALLET=0xYourLiquidityReserveWallet
# COMMUNITY_WALLET=0xYourCommunityRewardsWallet
# TREASURY_WALLET=0xYourTreasuryWallet
# STRATEGIC_RESERVE_WALLET=0xYourStrategicReserveWallet
