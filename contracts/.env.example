# Copy to .env (never commit .env). Used by Hardhat networks in hardhat.config.js

# Testnet / mainnet deployer (hex private key, 0x-prefixed).
# Do not commit the real value. A local generated copy exists at:
# contracts/.env.mainnet.local
# PRIVATE_KEY is intentionally omitted from committed files.

SYNTHOS_RPC_URL=http://localhost:8545
SYNTHOS_CHAIN_ID=1234

GEMINI_RPC_URL=http://localhost:8546
GEMINI_CHAIN_ID=2048

# Timelock min delay in seconds (deploy script default: 60 on hardhat, 172800 elsewhere)
# TIMELOCK_MIN_DELAY=172800

# Sovereign launch multisig. MULTISIG_OWNERS is comma-separated.
# If omitted on local Hardhat, deploy uses the first three local signers with a 2-of-3 threshold.
MULTISIG_OWNERS=0xa68A867aAdA7652eB3FeE14a5786B92317139B5c,0xD37fCaa767d425E11Ff7CC074B4e924cE60DcdB5,0x6DA0C1148c76b5bd77EF5455eE79A6859e865290
MULTISIG_THRESHOLD=2

# Launch allocation wallets. Use separate wallets or multisigs where possible.
# These are generated SYNTHOS founder-custody public addresses. Private keys
# are stored only in .synthos/mainnet-secrets/2026-07-02/ locally.
FOUNDER_WALLET=0x170D6650347ff4DaAC78B359e09C59a0e2D9758c
FOUNDER_OPS_WALLET=0xaedA7Eda4b49C93291293B050E3D5DDF595e7a1E
IMMUNE_NODE_REWARDS_WALLET=0x065d74523939E6b104B57517ba3214fAF7e949fD
VALIDATOR_REWARDS_WALLET=0x83f56978818fdDff0DBa1Ea3C27e9f61520ED447
DEX_LIQUIDITY_WALLET=0x5a2d2495c3834aD6443f0B134999A3B20CaF9060
COMMUNITY_WALLET=0xbb38733E80A1CD00268D3cB0BC1Da545122D4660
TREASURY_WALLET=0x5d6f8FbAAB199E788ed9Cfcb3F7Fe2ac9c0450d2
STRATEGIC_RESERVE_WALLET=0x1B844d31e73Fa7b2DD283898d58CC54c81F8e4a5

# Production DEX pools. Asset addresses are required outside local Hardhat;
# use [] until real verified asset contracts are deployed.
DEX_POOLS_JSON=[]

# Early adopter crypto sale.
# The sale contract sells SYN at $0.10 per token and transfers SYN instantly
# after a verified buyer pays with an enabled crypto asset.
# First active tranche from COMMUNITY_EARLY_ADOPTER_CAMPAIGNS.
# 250,000,000 SYN x $0.10 = $25,000,000 max tranche value.
EARLY_ADOPTER_SALE_ALLOCATION=250000000
EARLY_ADOPTER_MIN_SYN_PURCHASE=20
EARLY_ADOPTER_MAX_SYN_PER_WALLET=100000

# Accepted ERC-20 crypto payment assets. Use real deployed token addresses
# for the target network. Stablecoins normally use usdPrice 1.00.
#
# Ethereum mainnet examples:
# USDC 0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
# USDT 0xdAC17F958D2ee523a2206206994597C13D831ec7
# WBTC 0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599
# WETH 0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2
#
# Use WBTC for automatic Bitcoin exposure. Native BTC is not an ERC-20 asset
# and cannot trigger this EVM sale contract directly -- see the native BTC
# sale contract config below instead.
# Example:
# EARLY_ADOPTER_PAYMENT_ASSETS_JSON=[{"symbol":"USDC","address":"0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48","usdPrice":"1.00","enabled":true},{"symbol":"USDT","address":"0xdAC17F958D2ee523a2206206994597C13D831ec7","usdPrice":"1.00","enabled":true},{"symbol":"WBTC","address":"0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599","usdPrice":"61000","enabled":true},{"symbol":"WETH","address":"0xC02aaA39b223FE8D0A0e5C4F27eAD9083C756Cc2","usdPrice":"1700","enabled":true}]
EARLY_ADOPTER_PAYMENT_ASSETS_JSON=[]

# Optional native coin payments. Keep disabled unless you have a current USD
# price policy, because the contract does not use an external oracle.
EARLY_ADOPTER_NATIVE_PAYMENTS_ENABLED=false
EARLY_ADOPTER_NATIVE_USD_PRICE=0

# Enable WBTC specifically via scripts/enable-wbtc-payment.js (no new contract,
# just a setPaymentAsset() call against the existing sale contract).
WBTC_ADDRESS=0x2260FAC5E5542a773Aa44fBCfeDf7C193bc2C599
WBTC_USD_PRICE=61000

# Native Bitcoin sale (scripts/deploy-bitcoin-sale.js). Native BTC settles off
# this EVM chain entirely, so this deploys SYNTHOSBitcoinAdopterSale, a
# separate contract where an authorized confirmer records off-chain-verified
# BTC payments before SYN releases. Read contracts/BITCOIN_ADOPTER_SALE.md
# for the trust model before setting this up. The confirmer key must be held
# to the same custody standard as a treasury signer -- it can release SYN for
# any Bitcoin transaction it claims occurred, verified or not.
BITCOIN_SALE_CONFIRMER=
BITCOIN_SALE_ALLOCATION=50000000
BITCOIN_SALE_MIN_SYN_PURCHASE=20
BITCOIN_SALE_MAX_SYN_PER_WALLET=100000
