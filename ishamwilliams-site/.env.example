# Synthos Collective — Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── SMTP Email (for sending verification codes) ──────────────────────────
# Option 1: Gmail (recommended)
# 1. Enable 2FA on your Google account
# 2. Go to https://myaccount.google.com/apppasswords
# 3. Create an app password for "Mail"
# 4. Paste it below
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password-here

# Option 2: SendGrid (more reliable for production)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=SG.your-sendgrid-api-key

# ─── Admin Access ────────────────────────────────────────────────────────
# The founder-only admin page password
# This stays on the SERVER — it is never sent to browsers
ADMIN_PASSWORD=224369blockchainmind

# ─── Server ──────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ─── Synthos L1 RPC Node ────────────────────────────────────────────────
# URL to your running Go RPC node (synthosd.exe / rpcnode.exe)
VITE_API_URL=http://localhost:8080

# ─── Production Domain ───────────────────────────────────────────────────
# Set this when deploying to your domain
# FRONTEND_URL=https://www.ishamwilliamsblockchains.com
# VITE_API_URL=https://api.ishamwilliamsblockchains.com
